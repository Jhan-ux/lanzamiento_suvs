# =========================================================================
# CONFIGURACIÓN APACHE — MSA AUTOMOTRIZ LANZAMIENTO SUV
# =========================================================================

DirectoryIndex index.php index.html

# MIME Types para Modelos 3D GLB y audio/video
AddType model/gltf-binary .glb
AddType model/gltf+json .gltf
AddType audio/mpeg .mp3
AddType video/mp4 .mp4

# Establecer codificación UTF-8
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .php

# Compresión GZIP / Deflate para carga ultra rápida
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Cabeceras de caché para estáticos y modelos 3D
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType model/gltf-binary "access plus 1 month"
</IfModule>

# Seguridad básica y CORS para modelos 3D WebGL
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Access-Control-Allow-Origin "*"
</IfModule>
